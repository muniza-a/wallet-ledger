<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <!-- In-process HTTP tests against the ledger_test database. -->
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!-- Real parallel HTTP requests against the running API on :8080. -->
        <testsuite name="Concurrency">
            <directory>tests/Concurrency</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- Docker passes DB_DATABASE etc. as real environment variables, which PHP exposes in
             $_SERVER; Laravel reads $_SERVER before $_ENV. So each override is set as both
             <server> and <env>, or the container's values would win. -->
        <server name="APP_ENV" value="testing" force="true"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <!-- The container caches config at start-up; point tests at a cache file that never exists. -->
        <server name="APP_CONFIG_CACHE" value="/tmp/phpunit-no-config-cache.php" force="true"/>
        <env name="APP_CONFIG_CACHE" value="/tmp/phpunit-no-config-cache.php" force="true"/>
        <server name="APP_ROUTES_CACHE" value="/tmp/phpunit-no-routes-cache.php" force="true"/>
        <env name="APP_ROUTES_CACHE" value="/tmp/phpunit-no-routes-cache.php" force="true"/>
        <server name="DB_DATABASE" value="ledger_test" force="true"/>
        <env name="DB_DATABASE" value="ledger_test" force="true"/>
        <server name="DB_PERSISTENT" value="false" force="true"/>
        <env name="DB_PERSISTENT" value="false" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <server name="LOG_CHANNEL" value="stderr" force="true"/>
        <env name="LOG_CHANNEL" value="stderr" force="true"/>
    </php>
</phpunit>
