# Not needed for `docker compose up`: docker-compose.yml sets every value the API uses.
# Copy to .env only to run artisan or phpunit on the host against the Docker MySQL
# (published on port 3307). Docker Compose also reads API_TOKEN and FPM_WORKERS from .env.

APP_NAME="Wallet Ledger"
APP_ENV=local
APP_KEY=base64:Qm9yaW5nTGVkZ2VyS2V5Rm9yTm9FbmNyeXB0aW9uMDE=
APP_DEBUG=true
APP_URL=http://localhost:8080

API_TOKEN=recruitment-test-token
FPM_WORKERS=64

LOG_CHANNEL=stderr
LOG_LEVEL=debug

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=ledger
DB_USERNAME=ledger
DB_PASSWORD=ledger
DB_PERSISTENT=false
LIVE_DB_DATABASE=ledger
